[binaries]
c = ['xcrun', '-sdk', 'macosx', 'clang', '-arch', 'x86_64']
ar = 'ar'
strip = 'strip'

[properties]
needs_exe_wrapper = false

[host_machine]
system = 'darwin'
cpu_family = 'x86_64'
cpu = 'x86_64'
endian = 'little'

[built-in options]
c_args = ['-mmacosx-version-min=10.13']
c_link_args = ['-mmacosx-version-min=10.13']
